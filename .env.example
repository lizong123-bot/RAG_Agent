# ============================================================
# 复制本文件为 .env，并填入你自己的密钥
#     cp .env.example .env
# ============================================================

# ===== LLM（Chat 模型，用于 Agent）=====
# 以 DeepSeek 为例，也可换成其他 OpenAI 兼容接口
LLM_API_KEY=sk-你的LLM密钥
LLM_MODEL_ID=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# ===== Embedding 模型（用于向量化）=====
# 以阿里云百炼 Qwen text-embedding-v4 为例
# 国内账号：https://dashscope.aliyuncs.com/compatible-mode/v1
# 国际账号：https://dashscope-intl.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-你的Embedding密钥
EMBEDDING_MODEL_ID=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== Qdrant 向量库 =====
# Cloud：填集群 Endpoint（HTTPS，不带端口）
# 本地：http://localhost:6333
QDRANT_URL=https://xxx.qdrant.io
QDRANT_API_KEY=你的Qdrant密钥
QDRANT_COLLECTION_NAME=knowledge_base

# ===== 服务 =====
API_HOST=0.0.0.0
API_PORT=8000